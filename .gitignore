# Publish reviewed project directories; keep local execution products out.
*
!/.gitignore
!/README.md
!/questions/
!/questions/**
!/runs/
!/runs/**
!/submissions/
!/submissions/**
!/evaluations/
!/evaluations/**
!/costs/
!/costs/**
!/data/
!/data/**
!/results/
!/results/**
!/scripts/
!/scripts/**
**/__pycache__/
**/*.py[cod]
**/node_modules/
**/.venv/
**/.env
**/.env.*
**/*.inspect.ndjson
**/*.aux
**/*.log
**/*.fls
**/*.fdb_latexmk
**/*.synctex.gz
/.work/
